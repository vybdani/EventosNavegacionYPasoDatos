<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.eventosnavegacionypasodatos.controllers.MenuPrincipalController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu text="Archivo">
                            <items>
                                <MenuItem onAction="#handleAbrirRegistro" text="Registrar Cliente" />
                                <MenuItem onAction="#handleAbrirConsulta" text="Consultar Clientes" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleExportarRespaldo" text="Exportar Respaldo..." />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleSalir" text="Salir" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar>
                    <items>
                        <Button mnemonicParsing="false" onAction="#handleAbrirRegistro" text="Registrar Cliente" />
                        <Button mnemonicParsing="false" onAction="#handleAbrirConsulta" text="Consultar Clientes" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/logo.png" />
               </image>
            </ImageView>
                <Label text="Sistema de Solicitudes">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleAbrirRegistro" prefWidth="160.0" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Registrar Cliente" />
                        <Button mnemonicParsing="false" onAction="#handleAbrirConsulta" prefWidth="160.0" style="-fx-background-color: #17a2b8; -fx-text-fill: white;" text="Consultar Clientes" />
                    </children>
                </HBox>

                <Label fx:id="lblTotalClientes" text="Clientes registrados: 0">
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem onAction="#handleActualizarConteo" text="Actualizar contador" />
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </Label>
            </children>
        </VBox>
    </center>
</BorderPane>
