<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.eventosnavegacionypasodatos.controllers.ConsultaClienteController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label text="Consulta de Clientes">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar:" />
                <TextField fx:id="txtBuscar" promptText="Nombre o apellido" prefWidth="250.0" />
            </children>
        </HBox>

        <TableView fx:id="tblClientes" prefHeight="250.0" prefWidth="520.0">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130.0" />
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="130.0" />
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="150.0" />
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110.0" />
            </columns>
        </TableView>

        <HBox alignment="CENTER">
            <children>
                <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#handleCerrar" prefWidth="120.0" style="-fx-background-color: #dc3545; -fx-text-fill: white;" text="Cerrar" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
