<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" onKeyPressed="#handleKeyEvent" spacing="20.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.eventosnavegacionypasodatos.controllers.LoginController">
    <padding>
        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
    </padding>
    <children>
        <ImageView fitHeight="131.0" fitWidth="155.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../imagen/images.png" />
            </image>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </ImageView>

        <Label text="Sistema de Solicitudes">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <VBox spacing="5.0">
            <children>
                <Label text="Usuario:" />
                <TextField fx:id="txtUsuario" promptText="Ingresa tu usuario" />
            </children>
        </VBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtPassword" promptText="Ingresa tu contraseña" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="btnLogin" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin" prefWidth="120.0" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Iniciar Sesión" />
                <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#handleSalir" prefWidth="120.0" style="-fx-background-color: #dc3545; -fx-text-fill: white;" text="Salir" />
            </children>
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
